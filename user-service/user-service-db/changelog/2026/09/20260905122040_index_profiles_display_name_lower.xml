<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

<changeSet author="Morev Mark" id="20260905122040-index-profiles-display-name-lower">
    <preConditions onFail="MARK_RAN">
      <not><indexExists indexName="idx_profiles_display_name_lower"/></not>
    </preConditions>
    <sql>
      CREATE INDEX idx_profiles_display_name_lower ON profiles (lower(display_name));
    </sql>
    <rollback><sql>DROP INDEX IF EXISTS idx_profiles_display_name_lower;</sql></rollback>
  </changeSet>

</databaseChangeLog>
