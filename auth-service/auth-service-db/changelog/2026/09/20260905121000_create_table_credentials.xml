<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

<changeSet author="Morev Mark" id="20260905121000-create-table-credentials">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="credentials"/></not>
    </preConditions>
    <createTable tableName="credentials">
      <column name="user_id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="email" type="varchar(255)"/>
      <column name="phone" type="varchar(32)"/>
      <column name="username" type="varchar(64)">
        <constraints nullable="false" unique="true" uniqueConstraintName="ux_credentials_username"/>
      </column>
      <column name="password_hash" type="varchar(255)">
        <constraints nullable="false"/>
      </column>

      <column name="created_at" type="timestamp" defaultValueComputed="NOW()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp" defaultValueComputed="NOW()">
        <constraints nullable="false"/>
      </column>
      <column name="create_user" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="update_user" type="varchar(255)">
        <constraints nullable="false"/>
      </column>

    </createTable>
  </changeSet>

</databaseChangeLog>
