<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

<changeSet author="Morev Mark" id="20260905121030-index-credentials-username-lower">
    <preConditions onFail="MARK_RAN">
      <not><indexExists indexName="idx_credentials_username_lower"/></not>
    </preConditions>
    <sql>
      CREATE INDEX idx_credentials_username_lower
        ON credentials (lower(username));
    </sql>
    <rollback><sql>DROP INDEX IF EXISTS idx_credentials_username_lower;</sql></rollback>
  </changeSet>

</databaseChangeLog>
