<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

<changeSet author="Morev Mark" id="20260905121020-index-credentials-phone">
    <preConditions onFail="MARK_RAN">
      <not><indexExists indexName="ux_credentials_phone"/></not>
    </preConditions>
    <sql>
      CREATE UNIQUE INDEX ux_credentials_phone
        ON credentials (phone)
        WHERE phone IS NOT NULL;
    </sql>
    <rollback><sql>DROP INDEX IF EXISTS ux_credentials_phone;</sql></rollback>
  </changeSet>

</databaseChangeLog>
